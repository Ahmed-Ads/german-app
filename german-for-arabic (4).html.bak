<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>تعلّم الألمانية · Deutsch lernen</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#F7F4EC;
    --ink:#171512;
    --blue:#1E4FA3;
    --red:#C8342A;
    --yellow:#EBB111;
    --green:#2C6E49;
    --line: rgba(23,21,18,0.14);
    --card:#FFFFFF;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'Cairo', sans-serif;
    min-height:100vh;
    display:flex;
    flex-direction:column;
    align-items:center;
    padding:28px 16px 60px;
  }
  .de{ font-family:'Space Grotesk', sans-serif; direction:ltr; unicode-bidi: isolate; }
  .wrap{ width:100%; max-width:760px; }

  /* ---------- Header ---------- */
  header.app-head{
    display:flex; align-items:center; justify-content:space-between;
    margin-bottom:26px;
  }
  .brand{ display:flex; align-items:center; gap:12px; }
  .brand-mark{ width:34px; height:34px; position:relative; flex-shrink:0; }
  .brand-mark span{ position:absolute; border-radius:50%; }
  .brand-mark .c1{ width:20px;height:20px; background:var(--red); top:0; right:0; border-radius:50%; }
  .brand-mark .c2{ width:16px;height:16px; background:var(--yellow); bottom:0; left:2px; border-radius:2px; transform:rotate(20deg); }
  .brand-mark .c3{ width:12px;height:12px; background:var(--blue); bottom:2px; right:8px; border-radius:50%; }
  .brand h1{ font-size:19px; margin:0; font-weight:800; }
  .brand p{ margin:2px 0 0; font-size:12.5px; color:#6b6a66; }
  .backbtn{
    border:1.5px solid var(--ink); background:transparent; color:var(--ink);
    font-family:'Cairo',sans-serif; font-weight:700; font-size:14px;
    padding:8px 16px; border-radius:999px; cursor:pointer;
  }
  .backbtn:hover{ background:var(--ink); color:var(--paper); }

  /* ---------- Home grid ---------- */
  .grid{
    display:grid; grid-template-columns:repeat(auto-fill,minmax(210px,1fr));
    gap:14px;
  }
  .cat-card{
    background:var(--card); border:1.5px solid var(--line); border-radius:10px;
    padding:16px; cursor:pointer; text-align:right; position:relative; overflow:hidden;
    transition:transform .12s ease, border-color .12s ease;
  }
  .cat-card:hover{ transform:translateY(-2px); border-color:var(--ink); }
  .cat-shape{ width:26px; height:26px; margin-bottom:14px; border-radius:50%; }
  .cat-card h3{ margin:0 0 2px; font-size:16px; font-weight:700; }
  .cat-card .de{ display:block; font-size:13px; color:#6b6a66; margin-bottom:12px; }
  .bar-bg{ height:5px; border-radius:3px; background:var(--line); overflow:hidden; }
  .bar-fill{ height:100%; border-radius:3px; }
  .cat-meta{ font-size:11px; color:#8a8983; margin-top:6px; }

  /* ---------- Mode picker ---------- */
  .cat-title{ text-align:center; margin-bottom:26px; }
  .cat-title h2{ margin:0; font-size:24px; font-weight:800; }
  .cat-title .de{ display:block; font-size:16px; color:#6b6a66; margin-top:4px; }
  .wordcount-row{
    display:flex; align-items:center; justify-content:space-between;
    background:var(--card); border:1.5px solid var(--line); border-radius:10px;
    padding:12px 16px; margin-bottom:16px; font-size:13.5px;
  }
  .wordcount-row .backbtn{ padding:6px 14px; font-size:12.5px; }
  .modes{ display:flex; flex-direction:column; gap:12px; }

  /* ---------- Word list ---------- */
  .wl-list{ display:flex; flex-direction:column; gap:8px; }
  .wl-row{
    display:flex; align-items:center; gap:12px;
    background:var(--card); border:1.5px solid var(--line); border-radius:10px;
    padding:10px 14px;
  }
  .wl-speak{
    width:36px; height:36px; border-radius:50%; border:1.5px solid var(--ink);
    background:transparent; cursor:pointer; display:flex; align-items:center; justify-content:center;
    flex-shrink:0; color:var(--ink);
  }
  .wl-speak:hover{ background:var(--ink); color:var(--paper); }
  .wl-speak svg{ width:16px; height:16px; fill:currentColor; }
  .wl-text{ flex:1; display:flex; flex-direction:column; }
  .wl-de{ font-size:16px; font-weight:600; }
  .wl-ar{ font-size:13px; color:#6b6a66; margin-top:1px; }
  .wl-note{ font-size:12px; color:#8a8983; margin-top:3px; }
  .wl-num{ font-size:12px; color:#b3b1a8; font-family:'Space Grotesk',sans-serif; }
  .wl-divider{
    text-align:center; font-size:12.5px; color:#8a8983; background:rgba(23,21,18,0.05);
    border-radius:8px; padding:8px 12px; margin:6px 0 2px;
  }
  .mode-btn{
    display:flex; align-items:center; justify-content:space-between;
    background:var(--card); border:1.5px solid var(--line); border-radius:10px;
    padding:18px 20px; cursor:pointer; text-align:right;
  }
  .mode-btn:hover{ border-color:var(--ink); }
  .mode-btn .mt{ font-size:17px; font-weight:700; }
  .mode-btn .ms{ font-size:12.5px; color:#6b6a66; margin-top:2px; }
  .mode-icon{ width:30px; height:30px; flex-shrink:0; border-radius:8px; }

  /* ---------- Exercise ---------- */
  .progress-dots{ display:flex; justify-content:center; gap:8px; margin-bottom:22px; }
  .dot{ width:34px; height:6px; border-radius:3px; background:var(--line); position:relative; overflow:hidden; }
  .dot i{ position:absolute; inset:0; border-radius:3px; }
  .qcard{
    background:var(--card); border:1.5px solid var(--line); border-radius:14px;
    padding:34px 26px; text-align:center; margin-bottom:20px;
  }
  .qlabel{ font-size:12.5px; color:#8a8983; margin-bottom:10px; letter-spacing:.02em;}
  .qmain{ font-size:26px; font-weight:800; margin-bottom:6px; }
  .qsub{ font-size:14px; color:#6b6a66; }
  .speak-row{ display:flex; justify-content:center; margin-top:16px; }
  .speak-btn{
    width:46px; height:46px; border-radius:50%; border:1.5px solid var(--ink);
    background:transparent; cursor:pointer; display:flex; align-items:center; justify-content:center;
  }
  .speak-btn:hover{ background:var(--ink); }
  .speak-btn:hover svg{ fill:var(--paper); }
  .speak-btn svg{ width:20px; height:20px; fill:var(--ink); }

  .mini-speak{
    width:22px; height:22px; border-radius:50%; border:1.3px solid var(--ink);
    background:transparent; display:inline-flex; align-items:center; justify-content:center;
    cursor:pointer; vertical-align:middle; margin-inline-start:6px; padding:0;
  }
  .mini-speak svg{ width:10px; height:10px; fill:var(--ink); }
  .mini-speak:hover{ background:var(--ink); }
  .mini-speak:hover svg{ fill:var(--paper); }

  .options{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .opt{
    font-family:'Space Grotesk',sans-serif; direction:ltr; text-align:center;
    background:var(--card); border:1.5px solid var(--line); border-radius:10px;
    padding:16px 10px; font-size:16px; font-weight:600; cursor:pointer;
  }
  .opt:hover{ border-color:var(--blue); }
  .opt.correct{ background:var(--green); border-color:var(--green); color:#fff; }
  .opt.wrong{ background:var(--red); border-color:var(--red); color:#fff; }
  .opt.disabled{ pointer-events:none; }

  .article-options{ display:flex; gap:10px; justify-content:center; }
  .article-options .opt{ flex:1; max-width:140px; }

  .write-row{ display:flex; gap:10px; }
  .write-row input{
    flex:1; font-family:'Space Grotesk',sans-serif; direction:ltr; text-align:center;
    font-size:18px; padding:14px; border-radius:10px; border:1.5px solid var(--line);
    background:var(--card); color:var(--ink);
  }
  .write-row input:focus{ outline:none; border-color:var(--blue); }
  .submit-btn{
    font-family:'Cairo',sans-serif; font-weight:700; font-size:15px;
    background:var(--ink); color:var(--paper); border:none; border-radius:10px;
    padding:0 22px; cursor:pointer;
  }
  .submit-btn:disabled{ opacity:.4; cursor:default; }

  .feedback{ margin-top:16px; text-align:center; font-size:14.5px; min-height:20px; font-weight:700; }
  .feedback.ok{ color:var(--green); }
  .feedback.bad{ color:var(--red); }
  .fbnote{ margin-top:8px; font-weight:400; font-size:13px; color:#6b6a66; }

  .next-row{ display:flex; justify-content:center; margin-top:14px; }
  .next-btn{
    font-family:'Cairo',sans-serif; font-weight:700; font-size:14px;
    background:transparent; border:1.5px solid var(--ink); border-radius:999px;
    padding:9px 22px; cursor:pointer; display:none;
  }
  .next-btn.show{ display:inline-block; }

  .done-card{ text-align:center; padding:50px 20px; }
  .done-card h2{ font-size:22px; margin-bottom:8px; }
  .done-card p{ color:#6b6a66; font-size:14.5px; }

  .footnote{ text-align:center; font-size:12px; color:#9a9990; margin-top:36px; line-height:1.9; }
</style>
</head>
<body>
<div class="wrap" id="app"></div>

<script>
/* ======================= DATA ======================= */
const PALETTE = ['#C8342A','#1E4FA3','#EBB111','#2C6E49'];

const CATEGORIES = [
  { id:'obst', ar:'الفواكه', de:'Obst', order:8, hasArticles:true, words:[
    {a:'der',n:'Apfel',ar:'تفاحة',pl:'die Äpfel'},{a:'die',n:'Banane',ar:'موزة',pl:'die Bananen'},{a:'die',n:'Orange',ar:'برتقالة',pl:'die Orangen'},
    {a:'die',n:'Traube',ar:'عنبة',pl:'die Trauben'},{a:'die',n:'Erdbeere',ar:'فراولة',pl:'die Erdbeeren'},{a:'die',n:'Kirsche',ar:'كرزة',pl:'die Kirschen'},
    {a:'die',n:'Birne',ar:'كمثرى',pl:'die Birnen'},{a:'die',n:'Zitrone',ar:'ليمونة',pl:'die Zitronen'},
    {a:'die',n:'Ananas',ar:'أناناس',note:'الجمع الرسمي هو نفس الكلمة Ananas بلا تغيير، وAnanasse نادر الاستخدام',pl:'die Ananas'},
    {a:'der',n:'Pfirsich',ar:'خوخة',pl:'die Pfirsiche'},{a:'die',n:'Wassermelone',ar:'بطيخة',pl:'die Wassermelonen'},{a:'die',n:'Melone',ar:'شمام',pl:'die Melonen'},
    {a:'die',n:'Himbeere',ar:'توت العليق',pl:'die Himbeeren'},{a:'die',n:'Pflaume',ar:'برقوق',pl:'die Pflaumen'},{a:'die',n:'Mandarine',ar:'يوسفي',pl:'die Mandarinen'},
    {a:'die',n:'Kokosnuss',ar:'جوز الهند',pl:'die Kokosnüsse'},{a:'die',n:'Feige',ar:'تين',pl:'die Feigen'},{a:'die',n:'Dattel',ar:'تمر',pl:'die Datteln'},
    {a:'die',n:'Aprikose',ar:'مشمش',pl:'die Aprikosen'},{a:'die',n:'Grapefruit',ar:'جريب فروت',pl:'die Grapefruits'},{a:'die',n:'Heidelbeere',ar:'توت أزرق',pl:'die Heidelbeeren'},
    {a:'die',n:'Brombeere',ar:'توت أسود',pl:'die Brombeeren'},{a:'die',n:'Johannisbeere',ar:'كشمش',pl:'die Johannisbeeren'},{a:'die',n:'Kiwi',ar:'كيوي',pl:'die Kiwis'},
    {a:'die',n:'Mango',ar:'مانجو',note:'الجمع الرسمي Mangos، ونادرًا Mangonen',pl:'die Mangos'},{a:'die',n:'Papaya',ar:'بابايا',pl:'die Papayas'},{a:'die',n:'Litschi',ar:'ليتشي',pl:'die Litschis'},
    {a:'der',n:'Granatapfel',ar:'رمان',pl:'die Granatäpfel'},{a:'die',n:'Nektarine',ar:'نكتارين',pl:'die Nektarinen'},{a:'die',n:'Quitte',ar:'سفرجل',pl:'die Quitten'},
    {a:'die',n:'Stachelbeere',ar:'عنب الثعلب',note:'توت أخضر صغير حامض الطعم، شائع في الحلويات الألمانية',pl:'die Stachelbeeren'},
    {a:'die',n:'Preiselbeere',ar:'توت بري',pl:'die Preiselbeeren'},{a:'die',n:'Holunderbeere',ar:'بلسان',pl:'die Holunderbeeren'},
    {a:'die',n:'Maulbeere',ar:'توت',pl:'die Maulbeeren'},{a:'die',n:'Guave',ar:'جوافة',pl:'die Guaven'},{a:'die',n:'Passionsfrucht',ar:'فاكهة الباشن',pl:'die Passionsfrüchte'},
    {a:'die',n:'Drachenfrucht',ar:'فاكهة التنين',note:'فاكهة استوائية وردية القشرة بنقاط سوداء',pl:'die Drachenfrüchte'},
    {a:'die',n:'Sternfrucht',ar:'فاكهة النجمة',note:'فاكهة صفراء تشبه شكل النجمة عند تقطيعها',pl:'die Sternfrüchte'},
    {a:'die',n:'Avocado',ar:'أفوكادو',pl:'die Avocados'},
    {a:'das',n:'Kaki',ar:'كاكي',note:'فاكهة برتقالية طرية تُعرف أيضًا بالبرسيمون',pl:'die Kakis'},
    {a:'der',n:'Rhabarber',ar:'راوند',note:'نبات ساقه حامض يُطبخ كالفاكهة في الحلويات الألمانية؛ جمعه نفس الكلمة بلا تغيير',pl:'die Rhabarber'},
    {a:'die',n:'Zwetschge',ar:'خوخ أزرق',note:'نوع من البرقوق بيضاوي الشكل داكن اللون',pl:'die Zwetschgen'},
    {a:'die',n:'Mirabelle',ar:'خوخ أصفر صغير',note:'خوخ صغير أصفر حلو المذاق',pl:'die Mirabellen'},
    {a:'die',n:'Limette',ar:'ليم',pl:'die Limetten'},
    {a:'die',n:'Physalis',ar:'كشمش أرضي',note:'فاكهة صغيرة صفراء داخل غلاف ورقي يشبه الفانوس؛ الجمع Physalen، ويصح أيضًا Physalis بلا تغيير',pl:'die Physalen'},
    {a:'die',n:'Kumquat',ar:'كمكوات',note:'حمضيات صغيرة جدًا تؤكل بقشرها كاملة',pl:'die Kumquats'},
    {a:'der',n:'Sanddorn',ar:'نبق البحر',note:'توت برتقالي حامض غني بفيتامين C يُصنع منه عصير شائع في ألمانيا؛ يُستخدم عادة بلا جمع',pl:null},
    {a:'die',n:'Clementine',ar:'كليمنتين',pl:'die Clementinen'},
    {a:'die',n:'Hagebutte',ar:'ثمر الورد',note:'ثمرة حمراء صغيرة تُستخدم لصنع الشاي والمربى',pl:'die Hagebutten'},
    {a:'die',n:'Weichsel',ar:'كرز حامض',note:'نوع من الكرز الحامض يُستخدم في الكيك والحلويات',pl:'die Weichseln'}
  ]},
  { id:'gemuese', ar:'الخضروات', de:'Gemüse', order:9, hasArticles:true, words:[
    {a:'die',n:'Kartoffel',ar:'بطاطس',pl:'die Kartoffeln'},{a:'die',n:'Tomate',ar:'طماطم',pl:'die Tomaten'},{a:'die',n:'Gurke',ar:'خيار',pl:'die Gurken'},
    {a:'die',n:'Karotte',ar:'جزرة',pl:'die Karotten'},{a:'die',n:'Zwiebel',ar:'بصلة',pl:'die Zwiebeln'},
    {a:'der',n:'Knoblauch',ar:'ثوم',note:'ليس له جمع؛ يُستخدم دائمًا بصيغة المفرد',pl:null},
    {a:'der',n:'Kohl',ar:'كرنب',note:'الجمع Kohle نادر الاستخدام (يشير لأنواع الكرنب المختلفة)',pl:'die Kohle'},
    {a:'der',n:'Paprika',ar:'فلفل رومي',note:'الجمع الرسمي نفس الكلمة بلا تغيير، ويصح أيضًا Paprikas',pl:'die Paprika'},
    {a:'die',n:'Aubergine',ar:'باذنجان',pl:'die Auberginen'},
    {a:'der',n:'Spinat',ar:'سبانخ',note:'الجمع Spinate نادر الاستخدام (يشير لأنواع السبانخ)',pl:'die Spinate'},
    {a:'die',n:'Bohne',ar:'فاصوليا',pl:'die Bohnen'},{a:'der',n:'Salat',ar:'خس',pl:'die Salate'},
    {a:'die',n:'Zucchini',ar:'كوسة',note:'جمعها نفس الكلمة بلا تغيير',pl:'die Zucchini'},
    {a:'der',n:'Brokkoli',ar:'بروكلي',pl:'die Brokkolis'},{a:'der',n:'Pilz',ar:'فطر',pl:'die Pilze'},
    {a:'der',n:'Mais',ar:'ذرة',note:'الجمع Maise نادر الاستخدام (يشير لأنواع الذرة)',pl:'die Maise'},
    {a:'die',n:'Erbse',ar:'بازلاء',pl:'die Erbsen'},{a:'der',n:'Rettich',ar:'فجل',pl:'die Rettiche'},
    {a:'die',n:'Rote Bete',ar:'بنجر',note:'لا يوجد لها جمع شائع؛ تُستخدم بنفس الصيغة للمفرد والجمع',pl:null},
    {a:'der',n:'Sellerie',ar:'كرفس',note:'الجمع die Sellerie أو die Selleries، وفي النمسا Sellerien',pl:'die Sellerie'},
    {a:'die',n:'Süßkartoffel',ar:'بطاطا حلوة',pl:'die Süßkartoffeln'},
    {a:'der',n:'Kürbis',ar:'يقطين',pl:'die Kürbisse'},
    {a:'der',n:'Lauch',ar:'كراث',note:'الجمع Lauche نادر الاستخدام جدًا',pl:'die Lauche'},
    {a:'der',n:'Rosenkohl',ar:'كرنب بروكسل',note:'ليس له جمع؛ يُستخدم دائمًا بصيغة المفرد',pl:null},
    {a:'der',n:'Blumenkohl',ar:'قرنبيط',note:'الجمع Blumenkohle نادر الاستخدام',pl:'die Blumenkohle'},
    {a:'der',n:'Fenchel',ar:'شمر',note:'ليس له جمع؛ يُستخدم دائمًا بصيغة المفرد',pl:null},
    {a:'die',n:'Artischocke',ar:'خرشوف',pl:'die Artischocken'},
    {a:'die',n:'Okra',ar:'بامية',pl:'die Okras'},
    {a:'der',n:'Weißkohl',ar:'كرنب أبيض',note:'الجمع Weißkohle نادر الاستخدام',pl:'die Weißkohle'},
    {a:'der',n:'Rotkohl',ar:'كرنب أحمر',note:'الجمع Rotkohle نادر الاستخدام',pl:'die Rotkohle'},
    {a:'der',n:'Wirsing',ar:'كرنب مجعد',note:'نوع من الكرنب أوراقه مجعدة؛ جمعه Wirsinge نادر الاستخدام',pl:'die Wirsinge'},
    {a:'der',n:'Chinakohl',ar:'كرنب صيني',note:'الجمع Chinakohle نادر الاستخدام',pl:'die Chinakohle'},
    {a:'der',n:'Grünkohl',ar:'كرنب أخضر مجعد',pl:'die Grünkohle'},
    {a:'das',n:'Radieschen',ar:'فجل أحمر صغير',note:'جمعه نفس الكلمة بلا تغيير (كل الكلمات المصغّرة بـ chen لا تتغير في الجمع)',pl:'die Radieschen'},
    {a:'die',n:'Schalotte',ar:'بصل شالوت',pl:'die Schalotten'},
    {a:'der',n:'Spargel',ar:'هليون',note:'جمعه نفس الكلمة بلا تغيير',pl:'die Spargel'},
    {a:'der',n:'Feldsalat',ar:'خس الحقل',note:'نوع خس صغير الأوراق طري',pl:'die Feldsalate'},
    {a:'der',n:'Eisbergsalat',ar:'خس أيسبرغ',pl:'die Eisbergsalate'},
    {a:'der',n:'Kohlrabi',ar:'كرنب سلقي',pl:'die Kohlrabis'},
    {a:'der',n:'Champignon',ar:'فطر أبيض',pl:'die Champignons'},{a:'die',n:'Sojabohne',ar:'فول الصويا',pl:'die Sojabohnen'},
    {a:'die',n:'Kichererbse',ar:'حمص',pl:'die Kichererbsen'},
    {a:'der',n:'Meerrettich',ar:'فجل حار',note:'جذر حار الطعم يُستخدم كبديل للخردل',pl:'die Meerrettiche'},
    {a:'der',n:'Chicorée',ar:'شيكوريا',note:'خضار مر قليلًا يؤكل نيئًا في السلطة؛ ليس له جمع',pl:null},
    {a:'der',n:'Rucola',ar:'جرجير',note:'ليس له جمع؛ يُستخدم دائمًا بصيغة المفرد',pl:null},
    {a:'der',n:'Mangold',ar:'سلق',note:'خضار ورقي أخضر ذو سيقان ملونة، يشبه السبانخ',pl:'die Mangolde'},
    {a:'die',n:'Pastinake',ar:'جزر أبيض',note:'نوع من الجزر الأبيض حلو المذاق',pl:'die Pastinaken'},
    {a:'die',n:'Steckrübe',ar:'لفت سويدي',pl:'die Steckrüben'},
    {a:'die',n:'Kresse',ar:'رشاد',note:'نبات صغير سريع النمو يُستخدم لتزيين وتنكيه السلطات',pl:'die Kressen'},
    {a:'der',n:'Sauerampfer',ar:'حميض',note:'عشب ورقي حامض الطعم يُستخدم في الشوربات؛ جمعه نفس الكلمة بلا تغيير',pl:'die Sauerampfer'}
  ]},
