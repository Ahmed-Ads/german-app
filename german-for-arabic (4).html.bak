/* thresholds requested by user */
const THRESH = { mcq:10, written:10, article:8, plural:8 };
const UNLOCK_STEP = 5;

// "core" = the most essential/common words a learner should master first;
// the rest are "extra" bonus vocabulary. Categories can set an explicit
// `core` count; otherwise the first 20 words (already ordered by importance)
// are treated as core, or all of them if the category has fewer than 20.
function coreCountFor(cat){ return cat.core || Math.min(20, cat.words.length); }

const ORDERED_CATEGORIES = CATEGORIES.slice().sort((a,b) => (a.order||999) - (b.order||999));

/* ======================= STATE (persisted via window.storage) ======================= */
// progress[catId][mode] = { unlocked:Number, counts:{ wordIndex:Number } }
const PROGRESS_KEY = 'german-arabic-progress-v1';
let progress = {};
let progressReady = false;
let saveTimer = null;

async function loadProgress(){
  try{
    const res = await window.storage.get(PROGRESS_KEY, false);
    if(res && res.value) progress = JSON.parse(res.value);
  }catch(e){
    // no saved progress yet, or storage unavailable — start fresh
    progress = {};
  }
  progressReady = true;
}

// stats = { lastDate:'YYYY-MM-DD', current:N, longest:N, totalAnswered:N, totalCorrect:N }
const STATS_KEY = 'german-arabic-stats-v1';
let stats = { lastDate:null, current:0, longest:0, totalAnswered:0, totalCorrect:0 };
let statsSaveTimer = null;

async function loadStats(){
  try{
    const res = await window.storage.get(STATS_KEY, false);
    if(res && res.value) stats = Object.assign({ lastDate:null, current:0, longest:0, totalAnswered:0, totalCorrect:0 }, JSON.parse(res.value));
  }catch(e){
    stats = { lastDate:null, current:0, longest:0, totalAnswered:0, totalCorrect:0 };
  }
}

function saveStatsSoon(){
  clearTimeout(statsSaveTimer);
  statsSaveTimer = setTimeout(async ()=>{
    try{ await window.storage.set(STATS_KEY, JSON.stringify(stats), false); }
    catch(e){ /* saving failed silently; stats still work in-memory this session */ }
  }, 250);
}

function todayStr(){
  const d = new Date();
  return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
}

function daysBetween(d1, d2){
  const a = new Date(d1 + 'T00:00:00');
  const b = new Date(d2 + 'T00:00:00');
  return Math.round((b - a) / 86400000);
}

// The streak the learner should actually SEE right now — if it's been more
// than a day since their last recorded activity, the streak is broken even
// though we don't overwrite the stored number until they act again.
function displayStreak(){
  if(!stats.lastDate) return 0;
  const diff = daysBetween(stats.lastDate, todayStr());
  return diff <= 1 ? stats.current : 0;
}

// Call this on every answered question, anywhere in the app (normal
// practice modes, global review, difficult bank, quiz, section review).
function recordActivity(ok){
  stats.totalAnswered = (stats.totalAnswered || 0) + 1;
  if(ok) stats.totalCorrect = (stats.totalCorrect || 0) + 1;
  const today = todayStr();
  if(stats.lastDate !== today){
    if(stats.lastDate){
      const diff = daysBetween(stats.lastDate, today);
      stats.current = (diff === 1) ? (stats.current || 0) + 1 : 1;
    } else {
      stats.current = 1;
    }
    stats.lastDate = today;
    if(stats.current > (stats.longest || 0)) stats.longest = stats.current;
  }
  saveStatsSoon();
}

// A word counts as fully "mastered" only once every mode it can be tested
// in (mcq/written, plus article for noun categories) has reached threshold.
function computeMasteredCount(){
  let count = 0;
  CATEGORIES.forEach(cat=>{
    const catProg = progress[cat.id];
    if(!catProg) return;
    const modes = cat.hasArticles ? ['mcq','written','article'] : ['mcq','written'];
    for(let i=0;i<cat.words.length;i++){
      const allMastered = modes.every(m => catProg[m] && (catProg[m].counts[i]||0) >= threshFor(m));
      if(allMastered) count++;
    }
  });
  return count;
}

function saveProgressSoon(){
  clearTimeout(saveTimer);
  saveTimer = setTimeout(async ()=>{
    try{ await window.storage.set(PROGRESS_KEY, JSON.stringify(progress), false); }
    catch(e){ /* saving failed silently; progress still works in-memory this session */ }
  }, 250);
}

function ensureProgress(catId, mode){
  progress[catId] = progress[catId] || {};
  if(!progress[catId][mode]){
    progress[catId][mode] = { unlocked: UNLOCK_STEP, counts:{}, coreAcked:false };
  }
  return progress[catId][mode];
}
function threshFor(mode){ return THRESH[mode]; }

// true once the learner has mastered every "core" word for this mode
function coreDone(catId, mode){
  const cat = CATEGORIES.find(c=>c.id===catId);
  const core = coreCountFor(cat);
  const th = threshFor(mode);
  for(let i=0;i<core;i++){
    if(mode === 'plural' && !cat.words[i].pl) continue; // no plural to test for this word
    if(getWordCount(catId,mode,i) < th) return false;
  }
  return true;
}

function getWordCount(catId, mode, idx){
  const p = ensureProgress(catId, mode);
  return p.counts[idx] || 0;
}
function setWordCount(catId, mode, idx, val){
  const p = ensureProgress(catId, mode);
  p.counts[idx] = Math.max(0, val);
  saveProgressSoon();
}

function resetAllProgress(){
  progress = {};
  saveProgressSoon();
}

// Used by the section quiz: force a word back into active practice
// across all of its normal modes when the learner gets it wrong.
function reinforceWord(catId, idx){
  const cat = CATEGORIES.find(c=>c.id===catId);
  const modes = cat.hasArticles ? ['mcq','written','article'] : ['mcq','written'];
  modes.forEach(m=>{
    const p = ensureProgress(catId, m);
    p.unlocked = Math.max(p.unlocked, idx+1);
    const th = threshFor(m);
    const cur = p.counts[idx] || 0;
    p.counts[idx] = Math.max(0, Math.min(cur, th - 3));
  });
  saveProgressSoon();
}

// Used by review mode: degrade only the 'plural' mode progress for one word
// (word+article progress is handled separately by reinforceWord).
function reinforcePlural(catId, idx){
  const p = ensureProgress(catId, 'plural');
  p.unlocked = Math.max(p.unlocked, idx+1);
  const th = threshFor('plural');
  const cur = p.counts[idx] || 0;
  p.counts[idx] = Math.max(0, Math.min(cur, th - 3));
  saveProgressSoon();
}

function categoryWords(catId){
  return CATEGORIES.find(c=>c.id===catId).words;
}

// Pool of {catId, idx} for every word the learner has already been
// introduced to (unlocked) in any category they've started practicing.
// Used by the global "review all" screen.
function learnedPool(){
  // A word only counts as "learned" if the learner has actually answered it
  // correctly at least once in some mode (counts[idx] > 0) — NOT just because
  // it fell inside the default "unlocked" window, which gets seeded (and can
  // get bumped) as a side effect of simply rendering progress bars on the
  // home/modes screens, even for modes the learner never actually opened.
  const pool = [];
  CATEGORIES.forEach(cat=>{
    const catProg = progress[cat.id];
    if(!catProg) return; // never opened this category at all
    const modes = cat.hasArticles ? ['mcq','written','article'] : ['mcq','written'];
    for(let i=0;i<cat.words.length;i++){
      const sources = modes.filter(m => catProg[m] && (catProg[m].counts[i]||0) > 0);
      if(sources.length) pool.push({ catId: cat.id, idx: i, sources });
    }
  });
  return pool;
}

// Pool of {catId, idx, count, th} for words the learner has attempted in a
// given mode but hasn't mastered yet (count < threshold) — including words
// that got knocked all the way down to 0 by repeated wrong answers, which
// are exactly the words worth surfacing. Sorted hardest (lowest count/th
// ratio) first. Used by the "بنك الكلمات الصعبة" difficult-words bank.
function difficultPool(mode){
  const th = threshFor(mode);
  const pool = [];
  CATEGORIES.forEach(cat=>{
    if(mode === 'article' && !cat.hasArticles) return;
    const catProg = progress[cat.id];
    if(!catProg || !catProg[mode]) return;
    const counts = catProg[mode].counts || {};
    Object.keys(counts).forEach(k=>{
      const idx = parseInt(k, 10);
      const c = counts[idx] || 0;
      if(c < th) pool.push({ catId: cat.id, idx, count: c, th });
    });
  });
  pool.sort((a,b) => (a.count/a.th) - (b.count/b.th));
  return pool;
}

function unlockedIndices(catId, mode){
  const cat = CATEGORIES.find(c=>c.id===catId);
  const p = ensureProgress(catId, mode);
  const n = Math.min(p.unlocked, cat.words.length);
  return Array.from({length:n}, (_,i)=>i);
}

function activeIndices(catId, mode){
  // words currently unlocked but not yet mastered
  const cat = CATEGORIES.find(c=>c.id===catId);
  const th = threshFor(mode);
  let idxs = unlockedIndices(catId, mode);
  if(mode === 'plural') idxs = idxs.filter(i => cat.words[i].pl); // skip words with no plural (pl: null)
  return idxs.filter(i => getWordCount(catId,mode,i) < th);
}
function masteredUnlockedIndices(catId, mode){
  const cat = CATEGORIES.find(c=>c.id===catId);
  const th = threshFor(mode);
  let idxs = unlockedIndices(catId, mode);
  if(mode === 'plural') idxs = idxs.filter(i => cat.words[i].pl);
  return idxs.filter(i => getWordCount(catId,mode,i) >= th);
}

function maybeUnlockMore(catId, mode){
  const cat = CATEGORIES.find(c=>c.id===catId);
  const p = ensureProgress(catId, mode);
  while(activeIndices(catId, mode).length === 0 && p.unlocked < cat.words.length){
    p.unlocked = Math.min(p.unlocked + UNLOCK_STEP, cat.words.length);
  }
}

function categoryProgressPct(catId, mode){
  const cat = CATEGORIES.find(c=>c.id===catId);
  const th = threshFor(mode);
  const words = mode === 'plural' ? cat.words.filter(w=>w.pl) : cat.words;
  if(words.length === 0) return 0;
  let sum = 0;
  cat.words.forEach((w,i)=>{ if(mode!=='plural' || w.pl) sum += Math.min(getWordCount(catId,mode,i), th); });
  return Math.round((sum / (words.length*th)) * 100);
}

/* ======================= SPEECH ======================= */
let deVoice = null;
function loadVoices(){
  const voices = speechSynthesis.getVoices();
  const deVoices = voices.filter(v=>v.lang && v.lang.toLowerCase().startsWith('de'));
  // Web Speech API has no standard "gender" field, so we use a best-effort
  // heuristic: prefer German voices whose name matches common male voice
  // identifiers used by browsers/OSes (e.g. "Markus" on macOS/iOS German).
  const maleHints = ['markus','stefan','yannick','conrad','klaus','hans','daniel','viktor','male','männlich'];
  deVoice = deVoices.find(v => maleHints.some(h => v.name.toLowerCase().includes(h))) || deVoices[0] || null;
}
if('speechSynthesis' in window){
  loadVoices();
  speechSynthesis.onvoiceschanged = loadVoices;
}
function speak(text){
  try{
    if(!('speechSynthesis' in window)) return;
    speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(text);
    u.lang = 'de-DE';
    if(deVoice) u.voice = deVoice;
    u.rate = 0.92;
    speechSynthesis.speak(u);
  }catch(e){ /* audio not critical */ }
}

/* ======================= NAV / RENDER ======================= */
let view = { screen:'home', catId:null, mode:null };
let exState = null; // current exercise runtime state
const app = document.getElementById('app');

// small inline speaker buttons (section names etc.) work via delegation so
// they don't need re-binding on every re-render
const MINI_SPEAK_SVG = '<svg viewBox="0 0 24 24"><path d="M3 10v4h4l5 5V5L7 10H3z"/><path d="M16 8.5a4.5 4.5 0 010 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
function miniSpeak(text){
  return `<button class="mini-speak" data-text="${text}" aria-label="نطق">${MINI_SPEAK_SVG}</button>`;
}
function speakText(cat){ return cat.speak || cat.de; }
function noteLine(w){ return w.note ? `<div class="fbnote">💡 ${w.note}</div>` : ''; }
// Plural mode is only offered once every word in the category has been
// reviewed for its plural form (pl: 'die X...' or pl: null if genuinely no plural)
function pluralReady(cat){ return cat.hasArticles && cat.words.every(w => w.pl !== undefined); }

// Generate plausible-but-wrong plural forms of the SAME word (different
// endings / umlaut choices), so the quiz actually tests the specific
// pattern for that word instead of just word recognition.
function applyUmlaut(word){
  const pairs = [['au','äu'],['a','ä'],['o','ö'],['u','ü']];
  for(const [from,to] of pairs){
    const idx = word.lastIndexOf(from);
    if(idx !== -1) return word.slice(0,idx) + to + word.slice(idx+from.length);
  }
  return word;
}
function pluralDistractors(singular, correctFull){
  const uml = applyUmlaut(singular);
  const set = new Set([
    'die '+singular, 'die '+singular+'e', 'die '+singular+'en', 'die '+singular+'er', 'die '+singular+'s',
    'die '+uml, 'die '+uml+'e', 'die '+uml+'en', 'die '+uml+'er'
  ]);
  set.delete(correctFull);
  return shuffle(Array.from(set)).slice(0,3);
}
app.addEventListener('click', function(e){
  const btn = e.target.closest('.mini-speak');
  if(btn){ e.stopPropagation(); speak(btn.dataset.text); }
}, true); // capture phase so this fires before a card/button's own click handler

function go(v){ view = Object.assign({}, view, v); exState = null; render(); window.scrollTo(0,0); }

function render(){
  if(view.screen==='home') return renderHome();
  if(view.screen==='modes') return renderModes();
  if(view.screen==='exercise') return renderExercise();
  if(view.screen==='wordlist') return renderWordList();
  if(view.screen==='globalReview') return renderGlobalReviewModes();
  if(view.screen==='difficultBank') return renderDifficultModes();
}

function headerHtml(showBack, backTo){
  return `
  <header class="app-head">
    <div class="brand">
      <div class="brand-mark"><span class="c1"></span><span class="c2"></span><span class="c3"></span></div>
      <div>
        <h1>تعلّم الألمانية</h1>
        <p class="de">Deutsch lernen</p>
      </div>
    </div>
    ${showBack ? `<button class="backbtn" id="backBtn">${backTo}</button>` : ''}
  </header>`;
}

function renderHome(){
  const cards = ORDERED_CATEGORIES.map((c,i)=>{
    const color = PALETTE[i % PALETTE.length];
    const mcqPct = categoryProgressPct(c.id,'mcq');
    const wPct = categoryProgressPct(c.id,'written');
    const core = coreCountFor(c);
    const extra = c.words.length - core;
    return `
    <div class="cat-card" data-cat="${c.id}">
      <div class="cat-shape" style="background:${color};border-radius:${i%2===0?'50%':'6px'}"></div>
      <h3>${c.ar}</h3>
      <span class="de">${c.de}${miniSpeak(speakText(c))}</span>
      <div class="bar-bg"><div class="bar-fill" style="width:${(mcqPct+wPct)/2}%;background:${color}"></div></div>
      <div class="cat-meta">${core} كلمة أساسية${extra>0 ? ` + ${extra} إضافية` : ''} · اختيار ${mcqPct}% · كتابة ${wPct}%</div>
    </div>`;
  }).join('');

  const poolCount = learnedPool().length;
  const diffCount = difficultPool('mcq').length + difficultPool('written').length;

  app.innerHTML = `
    ${headerHtml(false)}
    <p style="color:#6b6a66;font-size:14px;margin-bottom:18px;">اختر قسمًا لتبدأ التدريب على كلماته</p>
    <div class="cat-card" id="globalReviewCard" style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px;border:2px solid #1E1E1E;cursor:pointer;${poolCount===0?'opacity:0.6;':''}">
      <div style="text-align:right;">
        <h3 style="margin:0 0 4px;">🔁 مراجعة شاملة لكل الكلمات</h3>
        <span class="de" style="display:block;font-size:13px;color:#6b6a66;">${poolCount > 0 ? `${poolCount} كلمة اتعلمتها من كل الأقسام مع بعض` : 'لسه فاضية — ابدأ تدرّب على أي قسم وهتتملى تلقائي'}</span>
      </div>
      <button class="backbtn" style="white-space:nowrap;">ابدأ المراجعة</button>
    </div>
    <div class="cat-card" id="difficultBankCard" style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px;border:2px solid #C8342A;cursor:pointer;${diffCount===0?'opacity:0.6;':''}">
      <div style="text-align:right;">
        <h3 style="margin:0 0 4px;">🎯 بنك الكلمات الصعبة</h3>
        <span class="de" style="display:block;font-size:13px;color:#6b6a66;">${diffCount > 0 ? `${diffCount} كلمة لسه بتغلط فيها — يستاهلوا تركيز أكتر` : 'مفيش كلمات صعبة دلوقتي 🎉'}</span>
      </div>
      <button class="backbtn" style="white-space:nowrap;">ذاكرها</button>
    </div>
    <div class="grid">${cards}</div>
    <div class="footnote">
      تقدّمك محفوظ تلقائيًا وهيفضل موجود لما ترجع للتطبيق تاني.<br>
      <button class="backbtn" id="resetBtn" style="margin-top:10px;font-size:12px;padding:6px 14px;">تصفير كل التقدّم</button>
    </div>
  `;
  app.querySelectorAll('.cat-card[data-cat]').forEach(el=>{
    el.addEventListener('click', ()=> go({screen:'modes', catId: el.dataset.cat}));
  });
  const grc = document.getElementById('globalReviewCard');
  if(grc) grc.addEventListener('click', ()=> go({screen:'globalReview'}));
  const dbc = document.getElementById('difficultBankCard');
  if(dbc) dbc.addEventListener('click', ()=> go({screen:'difficultBank'}));
  document.getElementById('resetBtn').addEventListener('click', ()=>{
    if(confirm('هل أنت متأكد أنك عايز تصفّر كل التقدّم في كل الأقسام؟')){
      resetAllProgress();
      render();
    }
  });
}

function renderModes(){
  const cat = CATEGORIES.find(c=>c.id===view.catId);
  const mcqPct = categoryProgressPct(cat.id,'mcq');
  const wPct = categoryProgressPct(cat.id,'written');
  const artPct = cat.hasArticles ? categoryProgressPct(cat.id,'article') : null;

  app.innerHTML = `
    ${headerHtml(true,'رجوع للأقسام')}
    <div class="cat-title">
      <h2>${cat.ar}</h2>
      <span class="de">${cat.de}${miniSpeak(speakText(cat))}</span>
    </div>
    <div class="wordcount-row">
      <span>هذا القسم يحتوي على <b>${cat.words.length}</b> كلمة</span>
      <button class="backbtn" id="viewWordsBtn">عرض كل الكلمات</button>
    </div>
    <div class="modes">
      <div class="mode-btn" data-mode="mcq">
        <div><div class="mt">اختيار من متعدد</div><div class="ms">Multiple Choice · تقدّم ${mcqPct}%</div></div>
        <div class="mode-icon" style="background:${PALETTE[1]}"></div>
      </div>
      <div class="mode-btn" data-mode="written">
        <div><div class="mt">الكتابة</div><div class="ms">Written · تقدّم ${wPct}%</div></div>
        <div class="mode-icon" style="background:${PALETTE[0]};border-radius:50%"></div>
      </div>
      ${cat.hasArticles ? `
      <div class="mode-btn" data-mode="article">
        <div><div class="mt">أداة التعريف</div><div class="ms">der / die / das · تقدّم ${artPct}%</div></div>
        <div class="mode-icon" style="background:${PALETTE[2]};border-radius:4px"></div>
      </div>` : ''}
      ${pluralReady(cat) ? `
      <div class="mode-btn" data-mode="plural">
        <div><div class="mt">صيغة الجمع</div><div class="ms">Plural · تقدّم ${categoryProgressPct(cat.id,'plural')}%</div></div>
        <div class="mode-icon" style="background:${PALETTE[1]};border-radius:50% 50% 4px 4px"></div>
      </div>` : ''}
      <div class="mode-btn" data-mode="quiz">
        <div><div class="mt">اختبار القسم</div><div class="ms">يشمل كل كلمات القسم مخلوطة عشوائيًا</div></div>
        <div class="mode-icon" style="background:${PALETTE[3]};border-radius:50% 4px 50% 4px"></div>
      </div>
      ${pluralReady(cat) ? `
      <div class="mode-btn" data-mode="review">
        <div><div class="mt">مراجعة القسم</div><div class="ms">Review · الكلمة + الأداة + صيغة الجمع مع بعض</div></div>
        <div class="mode-icon" style="background:${PALETTE[0]};border-radius:50% 4px 4px 50%"></div>
      </div>` : ''}
    </div>
  `;
  document.getElementById('backBtn').addEventListener('click', ()=> go({screen:'home', catId:null}));
  document.getElementById('viewWordsBtn').addEventListener('click', ()=> go({screen:'wordlist'}));
  app.querySelectorAll('.mode-btn').forEach(el=>{
    el.addEventListener('click', ()=> go({screen:'exercise', mode: el.dataset.mode}));
  });
}

function renderWordList(){
  const cat = CATEGORIES.find(c=>c.id===view.catId);
  const core = coreCountFor(cat);
  const rows = cat.words.map((w,i)=>{
    const text = cat.hasArticles ? `${w.a} ${w.n}` : w.n;
    const divider = (i === core && core < cat.words.length)
      ? `<div class="wl-divider">✨ باقي الكلمات إضافية (extra) — كمّلها براحتك بعد ما تتقن الأساسي</div>` : '';
    return `
    ${divider}
    <div class="wl-row">
      <button class="wl-speak" data-text="${text}">
        <svg viewBox="0 0 24 24"><path d="M3 10v4h4l5 5V5L7 10H3z"/><path d="M16 8.5a4.5 4.5 0 010 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
      <div class="wl-text">
        <span class="de wl-de">${text}</span>
        <span class="wl-ar">${w.ar}</span>
        ${w.note ? `<span class="wl-note">💡 ${w.note}</span>` : ''}
      </div>
      <span class="wl-num">${i+1}</span>
    </div>`;
  }).join('');

  app.innerHTML = `
    ${headerHtml(true,'رجوع لأوضاع القسم')}
    <div class="cat-title">
      <h2>${cat.ar}</h2>
      <span class="de">${cat.de}${miniSpeak(speakText(cat))} · ${core} أساسية${cat.words.length>core?` + ${cat.words.length-core} إضافية`:''}</span>
    </div>
    <div class="wl-list">${rows}</div>
  `;
  document.getElementById('backBtn').addEventListener('click', ()=> go({screen:'modes'}));
  app.querySelectorAll('.wl-speak').forEach(el=>{
    el.addEventListener('click', ()=> speak(el.dataset.text));
  });
}

/* ------------ exercise engine ------------ */
function pickQuestionIndex(catId, mode){
  maybeUnlockMore(catId, mode);
  const active = activeIndices(catId, mode);
  const mastered = masteredUnlockedIndices(catId, mode);
  if(active.length === 0 && mastered.length === 0) return null; // done entirely
  // 20% chance to review an already-mastered (unlocked) word if any exist
  if(mastered.length > 0 && active.length > 0 && Math.random() < 0.2){
    return { idx: mastered[Math.floor(Math.random()*mastered.length)], review:true };
  }
  if(active.length === 0){
    return { idx: mastered[Math.floor(Math.random()*mastered.length)], review:true };
  }
  return { idx: active[Math.floor(Math.random()*active.length)], review:false };
}

function normalizeDe(s){
  return s.trim().toLowerCase()
    .replace(/ä/g,'ae').replace(/ö/g,'oe').replace(/ü/g,'ue').replace(/ß/g,'ss');
}

function modeLabel(mode){
  return mode==='mcq' ? 'اختيار من متعدد' : mode==='written' ? 'الكتابة' : mode==='article' ? 'أداة التعريف' : mode==='plural' ? 'صيغة الجمع' : mode==='review' ? 'مراجعة القسم' : 'اختبار القسم';
}

function renderExercise(){
  if(view.mode === 'globalMcq') return renderGlobalReviewStep('mcq');
  if(view.mode === 'globalWritten') return renderGlobalReviewStep('written');
  if(view.mode === 'diffMcq') return renderDifficultStep('mcq');
  if(view.mode === 'diffWritten') return renderDifficultStep('written');
  const cat = CATEGORIES.find(c=>c.id===view.catId);
  const mode = view.mode;
  if(mode === 'quiz') return renderQuiz(cat);
  if(mode === 'review') return renderReviewCat(cat);
  const words = cat.words;
  const th = threshFor(mode);

  // "stop notification": once the learner masters all core words for this
  // mode, pause once to celebrate and offer moving on before extras appear.
  const core = coreCountFor(cat);
  const p = ensureProgress(cat.id, mode);
  if(!p.coreAcked && core < words.length && coreDone(cat.id, mode)){
    const orderedIdx = ORDERED_CATEGORIES.findIndex(c=>c.id===cat.id);
    const nextCat = ORDERED_CATEGORIES[orderedIdx+1];
    app.innerHTML = `
      ${headerHtml(true,'رجوع لأوضاع القسم')}
      <div class="cat-title"><h2>${cat.ar}</h2><span class="de">${modeLabel(mode)} · ${cat.de}${miniSpeak(speakText(cat))}</span></div>
      <div class="done-card">
        <h2>🌟 أتقنت أهم ${core} كلمة في هذا القسم!</h2>
        <p>تقدر تكمّل الـ${words.length-core} كلمة الإضافية دلوقتي، أو تنتقل للقسم اللي بعده وترجع تكمّلهم في أي وقت — تقدمك محفوظ.</p>
      </div>
      <div class="next-row" style="flex-direction:column;gap:10px;">
        <button class="backbtn" id="continueExtra" style="width:100%;">كمّل الكلمات الإضافية دلوقتي</button>
        ${nextCat ? `<button class="backbtn" id="goNextCat" style="width:100%;">روح لقسم "${nextCat.ar}" التالي</button>` : ''}
      </div>
    `;
    document.getElementById('backBtn').addEventListener('click', ()=> go({screen:'modes'}));
    document.getElementById('continueExtra').addEventListener('click', ()=>{
      p.coreAcked = true; saveProgressSoon(); renderExercise();
    });
    const nextBtn2 = document.getElementById('goNextCat');
    if(nextBtn2) nextBtn2.addEventListener('click', ()=>{
      p.coreAcked = true; saveProgressSoon(); go({screen:'modes', catId: nextCat.id});
    });
    return;
  }

  const pick = pickQuestionIndex(cat.id, mode);
  const dotsIdx = unlockedIndices(cat.id, mode).filter(i => getWordCount(cat.id,mode,i) < th);
  const dotsHtml = (dotsIdx.length? dotsIdx : unlockedIndices(cat.id,mode)).slice(0,5).map(i=>{
    const pct = Math.min(100, Math.round((getWordCount(cat.id,mode,i)/th)*100));
    return `<div class="dot"><i style="width:${pct}%;background:${PALETTE[1]}"></i></div>`;
  }).join('');

  if(pick === null){
    app.innerHTML = `
      ${headerHtml(true,'رجوع للأقسام')}
      <div class="cat-title"><h2>${cat.ar}</h2><span class="de">${cat.de}${miniSpeak(speakText(cat))}</span></div>
      <div class="done-card">
        <h2>🎉 أتقنت كل كلمات هذا القسم في هذا التمرين</h2>
        <p>جرّب وضعًا آخر لنفس القسم أو انتقل إلى قسم جديد.</p>
      </div>
      <div class="next-row"><button class="backbtn" id="toModes">أوضاع أخرى لهذا القسم</button></div>
    `;
    document.getElementById('backBtn').addEventListener('click', ()=> go({screen:'home'}));
    document.getElementById('toModes').addEventListener('click', ()=> go({screen:'modes'}));
    return;
  }

  const idx = pick.idx;
  const w = words[idx];
  exState = { catId: cat.id, mode, idx, answered:false };

  app.innerHTML = `
    ${headerHtml(true,'رجوع لأوضاع القسم')}
    <div class="cat-title"><h2>${cat.ar}</h2><span class="de">${modeLabel(mode)} · ${cat.de}${miniSpeak(speakText(cat))}</span></div>
    <div class="progress-dots">${dotsHtml}</div>
    <div id="qzone"></div>
  `;
  document.getElementById('backBtn').addEventListener('click', ()=> go({screen:'modes'}));
  renderQuestion(cat, mode, idx, w);
}

/* ------------ section quiz: all words shuffled, one full pass ------------ */
function renderQuiz(cat){
  if(!exState || exState.catId !== cat.id || exState.mode !== 'quiz'){
    exState = {
      catId: cat.id, mode:'quiz',
      queue: shuffle(cat.words.map((_,i)=>i)),
      pos: 0, correct: 0, wrongCount: 0, answered:false
    };
  }
  const total = exState.queue.length;

  if(exState.pos >= total){
    const pct = Math.round((exState.correct/total)*100);
    app.innerHTML = `
      ${headerHtml(true,'رجوع لأوضاع القسم')}
      <div class="cat-title"><h2>${cat.ar}</h2><span class="de">نتيجة اختبار القسم · ${cat.de}${miniSpeak(speakText(cat))}</span></div>
      <div class="done-card">
        <h2>${exState.correct} / ${total} إجابة صحيحة (${pct}%)</h2>
        <p>${exState.wrongCount ? `${exState.wrongCount} كلمة رجعت للتدريب العادي (MCQ/كتابة) في هذا القسم عشان تراجعها.` : 'ممتاز! أجبت صح على كل كلمات القسم 🎉'}</p>
      </div>
      <div class="next-row"><button class="backbtn" id="retryQuiz">إعادة اختبار القسم</button></div>
    `;
    document.getElementById('backBtn').addEventListener('click', ()=> go({screen:'modes'}));
    document.getElementById('retryQuiz').addEventListener('click', ()=>{ exState = null; renderExercise(); });
    return;
  }

  const idx = exState.queue[exState.pos];
  const w = cat.words[idx];
  exState.answered = false;

  app.innerHTML = `
    ${headerHtml(true,'رجوع لأوضاع القسم')}
    <div class="cat-title"><h2>${cat.ar}</h2><span class="de">اختبار القسم · ${exState.pos+1} / ${total} · ${cat.de}${miniSpeak(speakText(cat))}</span></div>
    <div id="qzone"></div>
  `;
  document.getElementById('backBtn').addEventListener('click', ()=> go({screen:'modes'}));

  const zone = document.getElementById('qzone');
  const correctText = cat.hasArticles ? `${w.a} ${w.n}` : w.n;
  const pool = cat.words.filter((_,i)=>i!==idx);
  const distractors = shuffle(pool).slice(0,3).map(d => cat.hasArticles ? `${d.a} ${d.n}` : d.n);
  const options = shuffle([correctText, ...distractors]);
  zone.innerHTML = `
    <div class="qcard">
      <div class="qlabel">ما هي الكلمة الألمانية الصحيحة؟</div>
      <div class="qmain">${w.ar}</div>
    </div>
    <div class="options">${options.map(o=>`<div class="opt de" data-val="${o}">${o}</div>`).join('')}</div>
    <div class="feedback" id="fb"></div>
    <div class="next-row"><button class="next-btn" id="nextBtn">${exState.pos+1 < total ? 'التالي ←' : 'عرض النتيجة'}</button></div>
  `;
  zone.querySelectorAll('.opt').forEach(el=>{
    el.addEventListener('click', ()=>{
      if(exState.answered) return;
      exState.answered = true;
      const chosen = el.dataset.val;
      const ok = chosen === correctText;
      zone.querySelectorAll('.opt').forEach(o=>{
        o.classList.add('disabled');
        if(o.dataset.val === correctText) o.classList.add('correct');
        else if(o === el) o.classList.add('wrong');
      });
      if(ok){ exState.correct++; }
      else { exState.wrongCount++; reinforceWord(cat.id, idx); }
      recordActivity(ok);
      speak(correctText);
      const fb = document.getElementById('fb');
      fb.innerHTML = (ok
        ? `إجابة صحيحة! الكلمة: ${correctText}`
        : `إجابة غير صحيحة، الصحيحة هي: ${correctText} — هذه الكلمة هترجع لتدريب القسم العادي.`) + noteLine(w);
      fb.className = 'feedback ' + (ok?'ok':'bad');
      document.getElementById('nextBtn').classList.add('show');
    });
  });
  document.getElementById('nextBtn').addEventListener('click', ()=>{ exState.pos++; renderQuiz(cat); });
}

// ---- Review mode (per-category "مراجعة القسم" and global "مراجعة شاملة") ----
// Each word is tested in up to 2 back-to-back steps: (1) the word + its
// article, (2) its plural form — or, for words with no plural, a "لا يوجد
// جمع" option mixed in with real plurals from the same category, which
// specifically drills the "not every noun has a plural" lesson.
const NO_PLURAL_LABEL = 'لا يوجد جمع لهذه الكلمة';

function reviewTotalQ(queue){
  return queue.reduce((sum, it) => {
    const c = CATEGORIES.find(x => x.id === it.catId);
    return sum + (c.hasArticles ? 2 : 1);
  }, 0);
}

function renderReviewCat(cat){
  if(!exState || exState.kind !== 'catReview' || exState.catId !== cat.id){
    const queue = shuffle(cat.words.map((_,i)=>({ catId: cat.id, idx: i })));
    exState = { kind:'catReview', catId:cat.id, queue, pos:0, stage:0, correct:0, wrongCount:0, answered:false, totalQ: reviewTotalQ(queue) };
  }
  renderReviewScreen({
    backScreen:'modes', backLabel:'رجوع لأوضاع القسم',
    headerTitle: cat.ar,
    headerSub: `مراجعة القسم · ${cat.de}${miniSpeak(speakText(cat))}`,
    emptyMsg: 'مفيش كلمات في هذا القسم لسه.',
    rebuild: ()=>{ exState = null; renderReviewCat(cat); }
  });
}

// ---- Global review section: auto-collects every word the learner has
// actually answered correctly at least once, from every category, and
// offers it back as plain MCQ / Written practice (mode picker up top). ----
function renderGlobalReviewModes(){
  const pool = learnedPool();
  app.innerHTML = `
    ${headerHtml(true,'رجوع للرئيسية')}
    <div class="cat-title"><h2>🔁 مراجعة شاملة</h2><span style="display:block;font-size:14px;color:#6b6a66;margin-top:4px;">${pool.length} كلمة اتعلمتها من كل الأقسام مع بعض — بتتحدّث أول ما تتعلّم كلمة جديدة</span></div>
    <div class="modes">
      <div class="mode-btn" data-gmode="mcq">
        <div><div class="mt">اختيار من متعدد</div><div class="ms">MCQ · اختار الكلمة الألمانية الصحيحة</div></div>
        <div class="mode-icon" style="background:${PALETTE[1]};border-radius:50%"></div>
      </div>
      <div class="mode-btn" data-gmode="written">
        <div><div class="mt">الكتابة</div><div class="ms">Written · اكتب الكلمة بالألماني</div></div>
        <div class="mode-icon" style="background:${PALETTE[2]};border-radius:4px"></div>
      </div>
    </div>
  `;
  document.getElementById('backBtn').addEventListener('click', ()=> go({screen:'home'}));
  app.querySelectorAll('.mode-btn[data-gmode]').forEach(el=>{
    el.addEventListener('click', ()=>{
      exState = null;
      go({screen:'exercise', mode: el.dataset.gmode==='mcq' ? 'globalMcq' : 'globalWritten'});
    });
  });
}

function renderGlobalReviewStep(actualMode){
  if(!exState || exState.kind !== 'globalStep' || exState.actualMode !== actualMode){
    const queue = shuffle(learnedPool());
    exState = { kind:'globalStep', actualMode, queue, pos:0, correct:0, wrongCount:0, answered:false };
  } else if(exState.answered){
    // learner just answered the previous question and hit "next" — score it and advance
    if(exState.lastOk) exState.correct++; else exState.wrongCount++;
    exState.pos++;
    exState.answered = false;
  }

  const queue = exState.queue;

  if(queue.length === 0){
    app.innerHTML = `
      ${headerHtml(true,'رجوع للرئيسية')}
      <div class="cat-title"><h2>🔁 مراجعة شاملة</h2></div>
      <div class="done-card"><h2>لسه مفيش كلمات كفاية للمراجعة</h2><p>ابدأ تدرّب على أي قسم الأول (وجاوب صح على شوية كلمات)، وبعدين ارجع هنا تراجعها كلها مع بعض.</p></div>
    `;
    document.getElementById('backBtn').addEventListener('click', ()=> go({screen:'home'}));
    return;
  }

  if(exState.pos >= queue.length){
    const total = queue.length;
    const pct = Math.round((exState.correct / total) * 100);
    app.innerHTML = `
      ${headerHtml(true,'رجوع للرئيسية')}
      <div class="cat-title"><h2>🔁 مراجعة شاملة</h2><span style="display:block;font-size:14px;color:#6b6a66;margin-top:4px;">نتيجة وضع ${modeLabel(actualMode)}</span></div>
      <div class="done-card">
        <h2>${exState.correct} / ${total} إجابة صحيحة (${pct}%)</h2>
        <p>${exState.wrongCount ? `${exState.wrongCount} سؤال غلط رجّع كلماته للتدريب العادي في قسمها عشان تراجعها.` : 'ممتاز! أجبت صح على كل حاجة 🎉'}</p>
      </div>
      <div class="next-row" style="flex-direction:column;gap:10px;">
        <button class="backbtn" id="retryG" style="width:100%;">إعادة المراجعة بنفس الوضع</button>
        <button class="backbtn" id="toGModes" style="width:100%;">رجوع لاختيار الوضع</button>
      </div>
    `;
    document.getElementById('backBtn').addEventListener('click', ()=> go({screen:'home'}));
    document.getElementById('retryG').addEventListener('click', ()=>{ exState = null; renderGlobalReviewStep(actualMode); });
    document.getElementById('toGModes').addEventListener('click', ()=>{ exState = null; renderGlobalReviewModes(); });
    return;
  }

  const item = queue[exState.pos];
  const realCat = CATEGORIES.find(c => c.id === item.catId);
  const w = realCat.words[item.idx];

  app.innerHTML = `
    ${headerHtml(true,'رجوع للرئيسية')}
    <div class="cat-title"><h2>🔁 مراجعة شاملة</h2><span style="display:block;font-size:14px;color:#6b6a66;margin-top:4px;">وضع ${modeLabel(actualMode)} · كلمة ${exState.pos+1} / ${queue.length} · من قسم «${realCat.ar}»</span></div>
    <div id="qzone"></div>
  `;
  document.getElementById('backBtn').addEventListener('click', ()=> go({screen:'home'}));
  renderQuestion(realCat, actualMode, item.idx, w);
}

// ---- Difficult-words bank: the words the learner keeps getting wrong,
// across every category, sorted hardest-first (lowest count/threshold). ----
function renderDifficultModes(){
  const mcqN = difficultPool('mcq').length;
  const writtenN = difficultPool('written').length;
  app.innerHTML = `
    ${headerHtml(true,'رجوع للرئيسية')}
    <div class="cat-title"><h2>🎯 بنك الكلمات الصعبة</h2><span style="display:block;font-size:14px;color:#6b6a66;margin-top:4px;">الكلمات اللي لسه مش متقنها، مرتبة الأصعب الأول — بتتحدّث أول ما تجاوب غلط أو صح</span></div>
    <div class="modes">
      <div class="mode-btn" data-dmode="mcq">
        <div><div class="mt">اختيار من متعدد</div><div class="ms">MCQ · ${mcqN} كلمة محتاجة مراجعة</div></div>
        <div class="mode-icon" style="background:${PALETTE[1]};border-radius:50%"></div>
      </div>
      <div class="mode-btn" data-dmode="written">
        <div><div class="mt">الكتابة</div><div class="ms">Written · ${writtenN} كلمة محتاجة مراجعة</div></div>
        <div class="mode-icon" style="background:${PALETTE[2]};border-radius:4px"></div>
      </div>
    </div>
  `;
  document.getElementById('backBtn').addEventListener('click', ()=> go({screen:'home'}));
  app.querySelectorAll('.mode-btn[data-dmode]').forEach(el=>{
    el.addEventListener('click', ()=>{
      exState = null;
      go({screen:'exercise', mode: el.dataset.dmode==='mcq' ? 'diffMcq' : 'diffWritten'});
    });
  });
}

function renderDifficultStep(actualMode){
  if(!exState || exState.kind !== 'diffStep' || exState.actualMode !== actualMode){
    const queue = difficultPool(actualMode); // hardest-first, not shuffled on purpose
    exState = { kind:'diffStep', actualMode, queue, pos:0, correct:0, wrongCount:0, answered:false };
  } else if(exState.answered){
    if(exState.lastOk) exState.correct++; else exState.wrongCount++;
    exState.pos++;
    exState.answered = false;
  }

  const queue = exState.queue;

  if(queue.length === 0){
    app.innerHTML = `
      ${headerHtml(true,'رجوع للرئيسية')}
      <div class="cat-title"><h2>🎯 بنك الكلمات الصعبة</h2></div>
      <div class="done-card"><h2>مفيش كلمات صعبة دلوقتي في وضع ${modeLabel(actualMode)} 🎉</h2><p>كل الكلمات اللي جربتها في الوضع ده متقنها كويس، أو لسه ماجربتش أي كلمة فيه خالص. كمّل تدريب عادي وارجع هنا لما تلاقي كلمات بتغلط فيها.</p></div>
    `;
    document.getElementById('backBtn').addEventListener('click', ()=> go({screen:'home'}));
    return;
  }

  if(exState.pos >= queue.length){
    const total = queue.length;
    const pct = Math.round((exState.correct / total) * 100);
    app.innerHTML = `
      ${headerHtml(true,'رجوع للرئيسية')}
      <div class="cat-title"><h2>🎯 بنك الكلمات الصعبة</h2><span style="display:block;font-size:14px;color:#6b6a66;margin-top:4px;">نتيجة وضع ${modeLabel(actualMode)}</span></div>
      <div class="done-card">
        <h2>${exState.correct} / ${total} إجابة صحيحة (${pct}%)</h2>
        <p>${exState.wrongCount ? `${exState.wrongCount} كلمة لسه محتاجة شغل أكتر — هتفضل في البنك لحد ما تتقنها.` : 'جامد! ذاكرت كل الكلمات الصعبة صح 🎉'}</p>
      </div>
      <div class="next-row" style="flex-direction:column;gap:10px;">
        <button class="backbtn" id="retryD" style="width:100%;">إعادة المراجعة بنفس الوضع</button>
        <button class="backbtn" id="toDModes" style="width:100%;">رجوع لاختيار الوضع</button>
      </div>
    `;
    document.getElementById('backBtn').addEventListener('click', ()=> go({screen:'home'}));
    document.getElementById('retryD').addEventListener('click', ()=>{ exState = null; renderDifficultStep(actualMode); });
    document.getElementById('toDModes').addEventListener('click', ()=>{ exState = null; renderDifficultModes(); });
    return;
  }

  const item = queue[exState.pos];
  const realCat = CATEGORIES.find(c => c.id === item.catId);
  const w = realCat.words[item.idx];

  app.innerHTML = `
    ${headerHtml(true,'رجوع للرئيسية')}
    <div class="cat-title"><h2>🎯 بنك الكلمات الصعبة</h2><span style="display:block;font-size:14px;color:#6b6a66;margin-top:4px;">وضع ${modeLabel(actualMode)} · كلمة ${exState.pos+1} / ${queue.length} · من قسم «${realCat.ar}»</span></div>
    <div id="qzone"></div>
  `;
  document.getElementById('backBtn').addEventListener('click', ()=> go({screen:'home'}));
  renderQuestion(realCat, actualMode, item.idx, w);
}

function renderReviewScreen(opts){
  const queue = exState.queue;

  if(queue.length === 0){
    app.innerHTML = `
      ${headerHtml(true, opts.backLabel)}
      <div class="cat-title"><h2>${opts.headerTitle}</h2></div>
      <div class="done-card"><h2>مفيش كلمات كفاية للمراجعة لسه</h2><p>${opts.emptyMsg}</p></div>
    `;
    document.getElementById('backBtn').addEventListener('click', ()=> go({screen: opts.backScreen}));
    return;
  }

  if(exState.pos >= queue.length){
    const pct = Math.round((exState.correct / exState.totalQ) * 100);
    app.innerHTML = `
      ${headerHtml(true, opts.backLabel)}
      <div class="cat-title"><h2>${opts.headerTitle}</h2><span style="display:block;font-size:14px;color:#6b6a66;margin-top:4px;">نتيجة المراجعة</span></div>
      <div class="done-card">
        <h2>${exState.correct} / ${exState.totalQ} إجابة صحيحة (${pct}%)</h2>
        <p>${exState.wrongCount ? `${exState.wrongCount} سؤال غلط رجّع كلماته للتدريب العادي عشان تراجعها.` : 'ممتاز! أجبت صح على كل حاجة في المراجعة 🎉'}</p>
      </div>
      <div class="next-row"><button class="backbtn" id="retryReview">إعادة المراجعة</button></div>
    `;
    document.getElementById('backBtn').addEventListener('click', ()=> go({screen: opts.backScreen}));
    document.getElementById('retryReview').addEventListener('click', opts.rebuild);
    return;
  }

  const item = queue[exState.pos];
  const cat = CATEGORIES.find(c => c.id === item.catId);
  const idx = item.idx;
  const w = cat.words[idx];
  exState.answered = false;
  const stageLabel = cat.hasArticles ? ` · خطوة ${exState.stage+1} من 2` : '';

  app.innerHTML = `
    ${headerHtml(true, opts.backLabel)}
    <div class="cat-title"><h2>${opts.headerTitle}</h2><span style="display:block;font-size:14px;color:#6b6a66;margin-top:4px;">${opts.headerSub} · كلمة ${exState.pos+1} / ${queue.length}${stageLabel}</span></div>
    <div id="qzone"></div>
  `;
  document.getElementById('backBtn').addEventListener('click', ()=> go({screen: opts.backScreen}));
  const zone = document.getElementById('qzone');
  const isLast = exState.pos+1 >= queue.length;

  function goNext(){
    if(exState.stage === 0 && cat.hasArticles){
      exState.stage = 1;
    } else {
      exState.pos++;
      exState.stage = 0;
    }
    renderReviewScreen(opts);
  }

  if(exState.stage === 0){
    const correctText = cat.hasArticles ? `${w.a} ${w.n}` : w.n;
    const pool = cat.words.filter((_,i)=>i!==idx);
    let distractors = shuffle(pool).slice(0,3).map(d => cat.hasArticles ? `${d.a} ${d.n}` : d.n);
    if(distractors.length < 3){
      const others = CATEGORIES.filter(c => c.id!==cat.id && c.hasArticles===cat.hasArticles)
        .flatMap(c => c.words.map(d => cat.hasArticles ? `${d.a} ${d.n}` : d.n));
      distractors = shuffle([...distractors, ...shuffle(others)]).slice(0,3);
    }
    const options = shuffle([correctText, ...distractors]);
    const willBeLastStep = !cat.hasArticles && isLast;
    const srcTag = item.sources && item.sources.length
      ? `<div style="font-size:12px;color:#8a8983;margin-top:6px;">📍 اتعلمتها في: ${item.sources.map(modeLabel).join(' + ')}</div>` : '';
    zone.innerHTML = `
      <div class="qcard">
        <div class="qlabel">ما هي الكلمة الألمانية الصحيحة؟</div>
        <div class="qmain">${w.ar}</div>
        ${srcTag}
      </div>
      <div class="options">${options.map(o=>`<div class="opt de" data-val="${o}">${o}</div>`).join('')}</div>
      <div class="feedback" id="fb"></div>
      <div class="next-row"><button class="next-btn" id="nextBtn">${willBeLastStep ? 'عرض النتيجة' : 'التالي ←'}</button></div>
    `;
    zone.querySelectorAll('.opt').forEach(el=>{
      el.addEventListener('click', ()=>{
        if(exState.answered) return;
        exState.answered = true;
        const chosen = el.dataset.val;
        const ok = chosen === correctText;
        zone.querySelectorAll('.opt').forEach(o=>{
          o.classList.add('disabled');
          if(o.dataset.val === correctText) o.classList.add('correct');
          else if(o === el) o.classList.add('wrong');
        });
        if(ok){ exState.correct++; } else { exState.wrongCount++; reinforceWord(cat.id, idx); }
        recordActivity(ok);
        speak(correctText);
        const fb = document.getElementById('fb');
        fb.innerHTML = (ok ? `إجابة صحيحة! ${correctText}` : `إجابة غير صحيحة، الصحيحة هي: ${correctText}`) + noteLine(w);
        fb.className = 'feedback ' + (ok?'ok':'bad');
        document.getElementById('nextBtn').classList.add('show');
      });
    });
    document.getElementById('nextBtn').addEventListener('click', goNext);
    return;
  }

  // stage 1 — plural (only reached when cat.hasArticles is true)
  let correctText, options;
  if(w.pl){
    correctText = w.pl;
    const distractors = pluralDistractors(w.n, correctText);
    options = shuffle([correctText, ...distractors]);
  } else {
    correctText = NO_PLURAL_LABEL;
    const candidates = cat.words.filter((x,i)=> i!==idx && x.pl).map(x=>x.pl);
    const distractors = shuffle(candidates).slice(0,3);
    options = shuffle([correctText, ...distractors]);
  }
  zone.innerHTML = `
    <div class="qcard">
      <div class="qlabel">إيه صيغة الجمع الصحيحة لهذه الكلمة؟</div>
      <div class="qmain de">${w.a} ${w.n}</div>
      <div class="qsub">${w.ar}</div>
    </div>
    <div class="options">${options.map(o=>`<div class="opt ${o===NO_PLURAL_LABEL?'':'de'}" data-val="${o}">${o}</div>`).join('')}</div>
    <div class="feedback" id="fb"></div>
    <div class="next-row"><button class="next-btn" id="nextBtn">${isLast ? 'عرض النتيجة' : 'التالي ←'}</button></div>
  `;
  zone.querySelectorAll('.opt').forEach(el=>{
    el.addEventListener('click', ()=>{
      if(exState.answered) return;
      exState.answered = true;
      const chosen = el.dataset.val;
      const ok = chosen === correctText;
      zone.querySelectorAll('.opt').forEach(o=>{
        o.classList.add('disabled');
        if(o.dataset.val === correctText) o.classList.add('correct');
        else if(o === el) o.classList.add('wrong');
      });
      if(ok){ exState.correct++; } else { exState.wrongCount++; if(w.pl) reinforcePlural(cat.id, idx); }
      speak(w.pl || w.n);
      const fb = document.getElementById('fb');
      fb.innerHTML = (ok ? `إجابة صحيحة! ${correctText}` : `إجابة غير صحيحة، الصحيحة هي: ${correctText}`) + noteLine(w);
      fb.className = 'feedback ' + (ok?'ok':'bad');
      document.getElementById('nextBtn').classList.add('show');
    });
  });
  document.getElementById('nextBtn').addEventListener('click', goNext);
}

function renderQuestion(cat, mode, idx, w){
  const zone = document.getElementById('qzone');

  if(mode === 'mcq'){
    // question: show Arabic meaning, choose correct German word (with article if noun)
    const correctText = cat.hasArticles ? `${w.a} ${w.n}` : w.n;
    const pool = cat.words.filter((_,i)=>i!==idx);
    const distractors = shuffle(pool).slice(0,3).map(d => cat.hasArticles ? `${d.a} ${d.n}` : d.n);
    const options = shuffle([correctText, ...distractors]);
    zone.innerHTML = `
      <div class="qcard">
        <div class="qlabel">ما هي الكلمة الألمانية الصحيحة؟</div>
        <div class="qmain">${w.ar}</div>
      </div>
      <div class="options">${options.map(o=>`<div class="opt de" data-val="${o}">${o}</div>`).join('')}</div>
      <div class="feedback" id="fb"></div>
      <div class="next-row"><button class="next-btn" id="nextBtn">التالي ←</button></div>
    `;
    zone.querySelectorAll('.opt').forEach(el=>{
      el.addEventListener('click', ()=>{
        if(exState.answered) return;
        exState.answered = true;
        const chosen = el.dataset.val;
        const ok = chosen === correctText;
        zone.querySelectorAll('.opt').forEach(o=>{
          o.classList.add('disabled');
          if(o.dataset.val === correctText) o.classList.add('correct');
          else if(o === el) o.classList.add('wrong');
        });
        applyResult(cat.id, mode, idx, ok);
        speak(correctText);
        const fb = document.getElementById('fb');
        fb.innerHTML = (ok ? `إجابة صحيحة! الكلمة: ${correctText}` : `إجابة غير صحيحة، الصحيحة هي: ${correctText}`) + noteLine(w);
        fb.className = 'feedback ' + (ok?'ok':'bad');
        document.getElementById('nextBtn').classList.add('show');
      });
    });
  }

  if(mode === 'written'){
    zone.innerHTML = `
      <div class="qcard">
        <div class="qlabel">اكتب الكلمة بالألمانية</div>
        <div class="qmain">${w.ar}</div>
        <div class="qsub">${cat.hasArticles ? 'يمكنك كتابتها بدون أداة التعريف' : ''}</div>
      </div>
      <div class="write-row">
        <input type="text" id="wIn" autocomplete="off" placeholder="..." />
        <button class="submit-btn" id="wSub">تحقق</button>
      </div>
      <div class="feedback" id="fb"></div>
      <div class="next-row"><button class="next-btn" id="nextBtn">التالي ←</button></div>
    `;
    const input = document.getElementById('wIn');
    input.focus();
    const correctText = `${w.a?w.a+' ':''}${w.n}`;
    function submit(){
      if(exState.answered) return;
      const val = input.value.trim();
      if(!val) return;
      exState.answered = true;
      const given = normalizeDe(val).replace(/\s+/g,' ');
      const wantArticle = cat.hasArticles && w.a;
      const noArticleTyped = !/^(der|die|das)\s+/.test(given);
      const ok = wantArticle
        ? given === normalizeDe(correctText)
        : (noArticleTyped && given === normalizeDe(w.n));
      applyResult(cat.id, mode, idx, ok);
      speak(correctText);
      const fb = document.getElementById('fb');
      fb.innerHTML = (ok ? `إجابة صحيحة! الكلمة: ${correctText}` : `الإجابة الصحيحة: ${correctText}`) + noteLine(w);
      fb.className = 'feedback ' + (ok?'ok':'bad');
      input.disabled = true;
      document.getElementById('wSub').disabled = true;
      document.getElementById('nextBtn').classList.add('show');
    }
    document.getElementById('wSub').addEventListener('click', submit);
    input.addEventListener('keydown', e=>{ if(e.key==='Enter') submit(); });
  }

  if(mode === 'article'){
    const correctArt = w.a;
    zone.innerHTML = `
      <div class="qcard">
        <div class="qlabel">اختر أداة التعريف الصحيحة</div>
        <div class="qmain de">${w.n}</div>
        <div class="qsub">${w.ar}</div>
      </div>
      <div class="article-options">
        ${['der','die','das'].map(a=>`<div class="opt de" data-val="${a}">${a}</div>`).join('')}
      </div>
      <div class="feedback" id="fb"></div>
      <div class="next-row"><button class="next-btn" id="nextBtn">التالي ←</button></div>
    `;
    zone.querySelectorAll('.opt').forEach(el=>{
      el.addEventListener('click', ()=>{
        if(exState.answered) return;
        exState.answered = true;
        const chosen = el.dataset.val;
        const ok = chosen === correctArt;
        zone.querySelectorAll('.opt').forEach(o=>{
          o.classList.add('disabled');
          if(o.dataset.val === correctArt) o.classList.add('correct');
          else if(o === el) o.classList.add('wrong');
        });
        applyResult(cat.id, mode, idx, ok);
        speak(`${correctArt} ${w.n}`);
        const fb = document.getElementById('fb');
        fb.innerHTML = (ok ? `إجابة صحيحة! ${correctArt} ${w.n}` : `إجابة غير صحيحة، الصحيحة هي: ${correctArt} ${w.n}`) + noteLine(w);
        fb.className = 'feedback ' + (ok?'ok':'bad');
        document.getElementById('nextBtn').classList.add('show');
      });
    });
  }

  if(mode === 'plural'){
    const correctText = w.pl;
    const distractors = pluralDistractors(w.n, correctText);
    const options = shuffle([correctText, ...distractors]);
    zone.innerHTML = `
      <div class="qcard">
        <div class="qlabel">إيه صيغة الجمع الصحيحة؟</div>
        <div class="qmain de">${w.a} ${w.n}</div>
        <div class="qsub">${w.ar}</div>
      </div>
      <div class="options">${options.map(o=>`<div class="opt de" data-val="${o}">${o}</div>`).join('')}</div>
      <div class="feedback" id="fb"></div>
      <div class="next-row"><button class="next-btn" id="nextBtn">التالي ←</button></div>
    `;
    zone.querySelectorAll('.opt').forEach(el=>{
      el.addEventListener('click', ()=>{
        if(exState.answered) return;
        exState.answered = true;
        const chosen = el.dataset.val;
        const ok = chosen === correctText;
        zone.querySelectorAll('.opt').forEach(o=>{
          o.classList.add('disabled');
          if(o.dataset.val === correctText) o.classList.add('correct');
          else if(o === el) o.classList.add('wrong');
        });
        applyResult(cat.id, mode, idx, ok);
        speak(correctText);
        const fb = document.getElementById('fb');
        fb.innerHTML = (ok ? `إجابة صحيحة! ${correctText}` : `إجابة غير صحيحة، الصحيحة هي: ${correctText}`) + noteLine(w);
        fb.className = 'feedback ' + (ok?'ok':'bad');
        document.getElementById('nextBtn').classList.add('show');
      });
    });
  }
  if(nextBtn) nextBtn.addEventListener('click', ()=> renderExercise());
}

function applyResult(catId, mode, idx, ok){
  // Global review loop needs to know the outcome of the question it just
  // rendered (via the shared renderQuestion()) so it can score itself and
  // advance when the learner hits "next" — see renderGlobalReviewStep().
  if(exState && (exState.kind === 'globalStep' || exState.kind === 'diffStep')) exState.lastOk = ok;
  recordActivity(ok);
  const th = threshFor(mode);
  const cur = getWordCount(catId, mode, idx);
  if(ok){
    setWordCount(catId, mode, idx, Math.min(th, cur + 1));
  } else {
    // wrong: if it was mastered (review), demote it back into active practice
    // otherwise just reset streak-ish progress down a bit (not to zero, to avoid discouragement)
    if(cur >= th){
      setWordCount(catId, mode, idx, Math.max(0, th - 3));
    } else {
      setWordCount(catId, mode, idx, Math.max(0, cur - 1));
    }
  }
}

function shuffle(arr){
  const a = arr.slice();
  for(let i=a.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    [a[i],a[j]] = [a[j],a[i]];
  }
  return a;
}

async function init(){
  app.innerHTML = `<div class="done-card"><h2>...جارِ تحميل تقدّمك</h2></div>`;
  await loadProgress();
  render();
}
init();
</script>
</body>
</html>
